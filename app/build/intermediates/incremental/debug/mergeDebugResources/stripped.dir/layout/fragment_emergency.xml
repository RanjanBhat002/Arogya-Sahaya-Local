<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/emergency_light"
    android:gravity="center_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/emergency_red"
        android:padding="20dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨 Emergency"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Press SOS to call emergency contact"
            android:textColor="#CCffffff"
            android:textSize="16sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- SOS Button - large for elderly accessibility -->
        <Button
            android:id="@+id/btn_sos"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:text="SOS\nEMERGENCY"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/emergency_red"
            style="@style/Widget.MaterialComponents.Button"
            app:cornerRadius="110dp"
            android:elevation="10dp"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:id="@+id/tv_emergency_contact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set emergency contact in Profile"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- Call ASHA worker button -->
        <Button
            android:id="@+id/btn_call_asha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👩‍⚕️  Call ASHA Worker"
            android:textSize="20sp"
            android:backgroundTint="@color/primary"
            style="@style/Widget.MaterialComponents.Button"
            app:cornerRadius="12dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="In case of emergency, always call 112 (National Emergency Number)"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</LinearLayout>
